# Copy to .env (or set these as environment variables on your host)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=umd
# any long random text; the same text goes into the extension (More & Settings -> Cloud memory)
API_KEY=change-me-to-a-long-random-text
PORT=8787
